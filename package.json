{
    "name": "lagukan",
    "version": "3.1.0",
    "description": "Lagukan Music Bot - Shard-ready Discord music bot powered by Rainlink, Lavalink, and Discord.js v14",
    "main": "src/index.js",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "start": "node ./src/index.js",
        "start:termux": "STANDALONE_MODE=true node ./src/index.js",
        "validate:commands": "node ./src/functions/slashCommandValidator.js",
        "format": "prettier -w .",
        "format:check": "prettier -c ."
    },
    "dependencies": {
        "@resvg/resvg-wasm": "^2.6.2",
        "chalk": "^4.1.2",
        "dejavu-fonts-ttf": "^2.37.3",
        "discord-hybrid-sharding": "^2.2.6",
        "discord.js": "^14.25.1",
        "dotenv": "^17.3.1",
        "llyrics": "^1.3.1",
        "lodash": "^4.17.23",
        "mongoose": "^9.2.1",
        "node-cron": "^4.2.1",
        "pretty-ms": "^9.3.0",
        "rainlink": "^1.2.7",
        "rainlink-voice": "^1.0.1"
    },
    "devDependencies": {
        "@types/node-cron": "^3.0.11",
        "prettier": "^3.8.1"
    },
    "keywords": [
        "discord",
        "bot",
        "lagukan",
        "lagukan music bot",
        "music",
        "music bot",
        "discord bot",
