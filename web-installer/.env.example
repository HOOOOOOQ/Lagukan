# ============================================================================
# LAGUKAN WEB INSTALLER — BACKEND SERVER CONFIGURATION (OWNER ONLY)
# ============================================================================
# PENTING:
# - Simpan MONGO_URI HANYA di environment server backend (Vercel / VPS).
# - JANGAN PERNAH mengekspos MONGO_URI ke VITE_* atau ke browser/script Termux.

# Port HTTP server (default: 3000)
PORT=3000

# MongoDB Atlas pusat milik pemilik project Lagukan
# Contoh: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/lagukan_central?retryWrites=true&w=majority
MONGO_URI=

# Secret kriptografi untuk tanda tangan sesi autentikasi Dashboard (minimal 32 karakter acak)
SESSION_SECRET=ganti_dengan_secret_acak_minimal_32_karakter_aman

# Opsional: URL publik resmi website installer (otomatis terdeteksi dari header HTTPS jika dikosongkan)
PUBLIC_BASE_URL=

# Versi rilis resmi Lagukan Bot & URL repository resmi
LAGUKAN_BOT_VERSION=3.1.0
LAGUKAN_REPO_URL=https://github.com/HOOOOOOQ/Lagukan.git
LAGUKAN_SUPPORT_URL=https://discord.gg/kNdSkHchzH
