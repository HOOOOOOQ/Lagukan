#########################################
#         FILL IN ALL DETAILS BELOW     #
#########################################

# GENERAL CONFIGURATION
BOT_NAME = Lagukan # Discord bot name
TOKEN = # Your bot token
PREFIX = ! # Bot prefix
EMBED_COLOR = 5865F2 # Embed color (hex format, without #)
LEAVE_TIMEOUT = 60000 # Time (in ms) before the bot leaves when alone/not playing
DEFAULT_VOLUME = 100 # Default volume when bot joins a voice channel
MIN_VOLUME = 1 # Minimum volume level
MAX_VOLUME = 100 # Maximum volume level
MONGO_URI = # Your MongoDB connection URI
SUPPORT_SERVER_URL = "https://discord.gg/kNdSkHchzH" # Your Discord support server URL
DEBUG = false # Optional logger debug mode (set true to enable debug logs)
STANDALONE_MODE = false # Set true (or use `npm run start:termux`) on Android Termux to run in single-process lightweight mode

# VOICE ACTIVITY LOGGER CONFIGURATION
VOICE_LOG_ENABLED=true # Logs automatically to active Voice Channel Text Chat when Lagukan is in VC
TIMEZONE=Asia/Jakarta

# SERVER TAG LOGGER CONFIGURATION (Configure channel per server via /setlogs)
SERVER_MEMBERS_INTENT=true # Enable SERVER MEMBERS INTENT in Discord Developer Portal for real-time Server Tag detection

# LAVALINK CONNECTION (Recommended: Lavalink v4.2.2+ with libdave for Discord DAVE E2EE voice audio)
LAVALINK_NAME = Lagukan # Lavalink node name
LAVALINK_HOST = localhost # Lavalink server host (or external Lavalink host for Termux)
LAVALINK_PORT = 2333 # Lavalink server port
LAVALINK_PASSWORD = youshallnotpass # Lavalink server password
LAVALINK_SECURE = false # Use secure connection (true/false)
LAVALINK_DRIVER = lavalink/v4/koinu # Lavalink driver (lavalink/v4/koinu, lavalink/v3/koto, etc.)
VOICE_CONNECTION_TIMEOUT = 15000 # Timeout (ms) for Discord voice gateway handshake

# RAINLINK CONFIGURATION
LAVALINK_SOURCE = sp # Source ID used by /play search. Must match enabled Lavalink sources
DEFAULT_SEARCH_ENGINE = youtubeMusic # Available options: youtubeMusic, youtube, soundcloud
SEARCH_FALLBACK_ENGINE = youtube # Fallback engine if DEFAULT_SEARCH_ENGINE fails
LAVALINK_RETRY_COUNT = 10 # Bounded reconnect attempts per disconnect burst
LAVALINK_RETRY_TIMEOUT = 5000 # Delay (ms) between Lavalink reconnect attempts
MAX_PLAYLIST_TRACKS = 500 # Maximum tracks enqueued per playlist load

# OPTIONAL SPOTIFY METADATA API (For full Spotify Track/Album/Playlist metadata -> legal audio replacement)
SPOTIFY_CLIENT_ID = # Optional Spotify Developer App Client ID
SPOTIFY_CLIENT_SECRET = # Optional Spotify Developer App Client Secret
SPOTIFY_MARKET = ID # Market code for Spotify metadata lookup (e.g., ID, US)

# LAGUKAN CLOUD INSTALLER GATEWAY (Auto-filled by Official Lagukan Termux Web Installer — leave empty if using direct MONGO_URI)
LAGUKAN_CLOUD_MODE = false
LAGUKAN_API_URL =
LAGUKAN_INSTALL_ID =
LAGUKAN_API_KEY =


